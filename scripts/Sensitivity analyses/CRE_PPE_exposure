source(here::here("scripts", "00_setup.R"))
#---------------------------------------------------------
# Load data
#---------------------------------------------------------
treatment <- readRDS(
  here("data", "raw", "anti_treat_index.RData")
)
baseline <- readRDS(
  here("data", "raw", "baseline_outcomes_index.RData")
)
day_by_day <- readRDS(
  here("data", "processed", "day_by_day.rds")
)
#---------------------------------------------------------
# Restrict to CRE phenotype
#---------------------------------------------------------

day_by_day_cre <- day_by_day %>%
  filter(resistance_class == "ENT-CARB")

#---------------------------------------------------------
# Collapse antibiotics to one row per patient-day
#---------------------------------------------------------

combo_by_day_cre <- day_by_day_cre %>%
  group_by(recordid, day_relative_to_onset) %>%
  summarise(
    ab_combo = paste(sort(unique(anti_names)), collapse = "+"),
    .groups = "drop"
  )

#---------------------------------------------------------
# Add patient-day metadata
#---------------------------------------------------------

meta_per_day <- day_by_day_cre %>%
  select(
    recordid,
    day_relative_to_onset,
    inf_onset,
    org_combined,
    bsi_source_clean,
    bsi_pri_sec_label
  ) %>%
  distinct()

combo_by_day_cre <- combo_by_day_cre %>%
  left_join(
    meta_per_day,
    by = c("recordid", "day_relative_to_onset")
  ) %>%
  mutate(
    ab_combo = na_if(ab_combo, "")
  )

#---------------------------------------------------------
# Create BSI source variable
#---------------------------------------------------------

combo_by_day_cre <- combo_by_day_cre %>%
  mutate(
    bsi_source = case_when(
      bsi_pri_sec_label == "Primary (unknown origin / central line)" ~
        "Primary (unknown origin / central line)",
      bsi_pri_sec_label == "Secondary (defined infection focus)" ~
        paste("Secondary -", bsi_source_clean),
      TRUE ~ NA_character_
    )
  ) %>%
  select(
    recordid,
    day_relative_to_onset,
    ab_combo,
    inf_onset,
    org_combined,
    bsi_source
  )

#---------------------------------------------------------
# Define BAT
#---------------------------------------------------------
check_appropriateness_cre_row <- function(row) {
  # parse ab_combo
  ab_list <- unlist(strsplit(row$ab_combo, "\\+"))
  ab_list <- trimws(ab_list)
  # helper AST
  check_ast <- function(drug) {
    if (!drug %in% names(row)) return(NA)
    v <- suppressWarnings(as.numeric(row[[drug]]))
    if (is.na(v)) return(NA)
    if (v == 1) return("R")
    if (v == 2) return("I")
    if (v == 3) return("S")
    if (v %in% c(4,5)) return("Missing")
    return(NA)
  }
  if (c("Colistin" %in% ab_list)) return("Appropriate")
  if (c("Ceftazidime/avibactam" %in% ab_list)) return("Appropriate")
  if (c("Polymyxin B" %in% ab_list)) return("Appropriate")
  ## default
  return("Not appropriate")
}

# # apply function
combo_by_day_cre <- combo_by_day_cre %>%
  rowwise() %>%
  mutate(appropriateness = check_appropriateness_cre_row(pick(everything()))) %>%
  ungroup()

combo_by_day_cre <- combo_by_day_cre %>%
  select(recordid, ab_combo, appropriateness, everything())

combo_by_day_cre <- combo_by_day_cre %>%
  arrange(recordid, day_relative_to_onset) %>%
  group_by(recordid) %>%
  mutate(
    appropriate = appropriateness == "Appropriate",
    
    new_episode = appropriate & (
      !lag(appropriate, default = FALSE) |
        day_relative_to_onset !=
        lag(
          day_relative_to_onset,
          default = first(day_relative_to_onset) - 1
        ) + 1
    ),
    
    episode = if_else(
      appropriate,
      cumsum(new_episode),
      NA_integer_
    )
  ) %>%
  group_by(recordid, episode) %>%
  mutate(
    episode_start = if_else(
      !is.na(episode),
      min(day_relative_to_onset),
      NA_real_
    ),
    
    episode_length = if_else(
      !is.na(episode),
      n(),
      NA_integer_
    )
  ) %>%
  ungroup() %>%
  group_by(recordid) %>%
  mutate(
    early_start_day = {
      eligible_early_episode <- !is.na(episode) &
        episode_start %in% c(-1, 0, 1) &
        episode_length >= 3
      
      if (any(eligible_early_episode)) {
        min(episode_start[eligible_early_episode])
      } else {
        NA_real_
      }
    },
    
    A_day0 = as.integer(!is.na(early_start_day)),
    
    start_day = {
      eligible_later_episode <- !is.na(episode) &
        episode_start >= 2 &
        episode_length >= 3
      
      if (!is.na(first(early_start_day))) {
        0
      } else if (any(eligible_later_episode)) {
        min(episode_start[eligible_later_episode])
      } else {
        NA_real_
      }
    }
  ) %>%
  ungroup()

#---------------------------------------------------------
# Define exposure regimen
#---------------------------------------------------------

exposure_regimen <- combo_by_day_cre %>%
  group_by(recordid) %>%
  summarise(
    exposure_regimen = if (first(A_day0) == 1) {
      
      first(
        ab_combo[
          day_relative_to_onset == first(early_start_day)
        ]
      )
      
    } else {
      
      regimens <- unique(
        na.omit(
          ab_combo[
            day_relative_to_onset %in% c(-1, 0, 1)
          ]
        )
      )
      
      if (length(regimens) == 0) {
        "Not on therapy"
      } else {
        paste(regimens, collapse = " | ")
      }
    },
    
    .groups = "drop"
  )

combo_by_day_cre <- combo_by_day_cre %>%
  left_join(
    exposure_regimen,
    by = "recordid"
  )
