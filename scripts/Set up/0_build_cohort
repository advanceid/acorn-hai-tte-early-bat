#---------------------------------------------------------
# Resistance class
#---------------------------------------------------------

day_by_day <- day_by_day %>%
  mutate(
    resistance_class = case_when(
      aci_car  == 1 ~ "ACI-CARB",
      pse_car  == 1 ~ "PSE-CARB",
