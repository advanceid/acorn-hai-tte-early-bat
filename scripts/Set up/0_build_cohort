#---------------------------------------------------------
# Add BSI source
#---------------------------------------------------------
bsi <- bsi%>%
  filter(redcap_repeat_instance == "1")
day_by_day <- day_by_day %>%
  left_join(
    bsi %>% select(recordid, bsi_pri_sec, starts_with("bsi_pri_sec_1")),
    by = "recordid"
  )

day_by_day <- day_by_day %>%
  mutate(
    bsi_pri_sec_label = case_when(
      bsi_pri_sec == 1 ~ "Primary (unknown origin / central line)",
      bsi_pri_sec == 2 ~ "Secondary (defined infection focus)",
      bsi_pri_sec == 3 ~ "Unknown",
      TRUE ~ NA_character_
    ),
    bsi_source = case_when(
      `bsi_pri_sec_1___1` == 1 ~ "Skin/Soft tissue",
      `bsi_pri_sec_1___2` == 1 ~ "Pulmonary",
      `bsi_pri_sec_1___3` == 1 ~ "Digestive tract",
      `bsi_pri_sec_1___4` == 1 ~ "Urinary tract",
      `bsi_pri_sec_1___5` == 1 ~ "Surgical site",
      `bsi_pri_sec_1___6` == 1 ~ "Unknown",
      `bsi_pri_sec_1___7` == 1 ~ paste("Other:", bsi_pri_sec_1_other),
      TRUE ~ NA_character_
    )
  )

day_by_day <- day_by_day %>%
  mutate(
    bsi_other_raw  = bsi_pri_sec_1_other,
    bsi_other_clean = bsi_other_raw |> 
      str_to_lower() |> 
      str_replace_all("[^\\p{L}\\p{N}\\s]", " ") |>  
      str_squish()
  )

map_source <- function(x){
  case_when(
    is.na(x) ~ NA_character_,
    
    # Urinary
    str_detect(x, "pyelo|uroseps|urinar|pcn|nephrost|kidney infect|uti|renal (cyst|collec)") ~ "Urinary tract",
    
    # Pulmonary
    str_detect(x, "pneum|lung|empyema|pleur|tracheit|t1rf|supraglott|pulmon|肺|脓胸") ~ "Pulmonary",
    
    # Digestive/Hepatobiliary/GI
    str_detect(x, "cholang|choledoch|hpb|hepatobili|bile|biliary|liver abscess|gi tract|gastrointestinal|abd(omen|ominal)|intra ?abdom|periton|appendic|pancreat|ascites|anastom|perforat|peritonitis|gut") ~ "Digestive tract",
    
    # Skin/Soft tissue / SSTI
    str_detect(x, "cellulit|skin|soft tissue|sacral sore|pressure sore|wound|fournier|necrot|tophi|ulcer|absces|epidural|psoas|musculoskeletal|back lump|neck abce") ~ "Skin/Soft tissue",
    
    # Surgical site
    str_detect(x, "postop|surgical site|post[- ]?operative") ~ "Surgical site",
    
    # Line-related / catheter / phlebitis  → se vuoi considerarle *primary* valuta separato
    str_detect(x, "central line|picc|portacath|peripheral (iv|line)|branulla|catheter|crbsi|phlebit|thrombophlebit|cvc|line") ~ "Catheter/Line-related",
    
    # Neurological / CSF
    str_detect(x, "meningit|csf|hydrocephalus|neuro") ~ "Neurological/CSF",
    
    # Cardiac / Endocarditis
    str_detect(x, "endocardit|ie|cardiac|cied") ~ "Cardiac/Endocarditis",
    
    # Malignancy/hematology (se vuoi tenerla)
    str_detect(x, "aml|all|leukemia|lymphoma|malignan|cancer|hcc|tumou?r|cld") ~ "Malignancy/Oncology",
    
    # Trauma/obstetric
    str_detect(x, "trauma|post mva|abruptio|pue?peral|neonatal") ~ "Other (trauma/obstetric/neonatal)",
    
    TRUE ~ "Other (unmapped)"
  )
}

day_by_day <- day_by_day %>%
  mutate(
    bsi_source_clean =
      case_when(
        bsi_pri_sec == 2 & `bsi_pri_sec_1___1` == 1 ~ "Skin/Soft tissue",
        bsi_pri_sec == 2 & `bsi_pri_sec_1___2` == 1 ~ "Pulmonary",
        bsi_pri_sec == 2 & `bsi_pri_sec_1___3` == 1 ~ "Digestive tract",
        bsi_pri_sec == 2 & `bsi_pri_sec_1___4` == 1 ~ "Urinary tract",
        bsi_pri_sec == 2 & `bsi_pri_sec_1___5` == 1 ~ "Surgical site",
        bsi_pri_sec == 2 & `bsi_pri_sec_1___6` == 1 ~ "Unknown",
        bsi_pri_sec == 2 & `bsi_pri_sec_1___7` == 1 ~ map_source(bsi_other_clean),
        TRUE ~ NA_character_
      )
  )

day_by_day %>%
  filter(bsi_pri_sec==2, `bsi_pri_sec_1___7`==1) %>%
  count(bsi_source_clean, sort = TRUE)

