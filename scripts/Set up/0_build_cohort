#---------------------------------------------------------
# Setup
#---------------------------------------------------------
source(here::here("scripts", "00_setup.R"))
#---------------------------------------------------------
# Load data
#---------------------------------------------------------
treatment <- readRDS(
  here("data", "raw", "anti_treat_index.RData")
)
#---------------------------------------------------------
# Restrict to bloodstream infections
#---------------------------------------------------------
treatment_clean <- treatment %>%
  filter(
    infection_types %in% c(
      "Healthcare-associated BSI",
      "Hospital-acquired BSI"
    )
  ) %>%
  mutate(
    anti_start = as.Date(anti_start),
    anti_end   = as.Date(anti_end),
    inf_onset  = as.Date(inf_onset),
    anti_end   = if_else(
      is.na(anti_end) & !is.na(anti_start),
      anti_start,
      anti_end
    )
  ) %>%
  filter(
    !is.na(anti_start),
    !is.na(anti_end),
    !is.na(anti_names)
  )
#---------------------------------------------------------
# Resolve multiple records for the same antibiotic course
#---------------------------------------------------------
dup_check <- treatment_clean %>%
  group_by(recordid, anti_names, anti_start) %>%
  filter(n() > 1)

if (nrow(dup_check) > 0) {
  message(
    nrow(dup_check),
    " duplicated antibiotic records detected."
  )
}

treatment_clean <- treatment_clean %>%
  group_by(recordid, anti_names, anti_start) %>%
  slice_max(
    order_by = anti_end,
    with_ties = FALSE
  ) %>%
  ungroup()
#---------------------------------------------------------
# Remove inconsistent records
#---------------------------------------------------------
treatment_clean <- treatment_clean %>%
  filter(anti_end >= anti_start)
#---------------------------------------------------------
# Expand antibiotic episodes to one row per day
#---------------------------------------------------------
day_by_day <- treatment_clean %>%
  rowwise() %>%
  mutate(
    days_seq = list(
      seq.Date(
        anti_start,
        anti_end,
        by = "day"
      )
    )
  ) %>%
  unnest(days_seq) %>%
  mutate(
    day_relative_to_onset =
      as.integer(days_seq - inf_onset)
  ) %>%
  ungroup()

