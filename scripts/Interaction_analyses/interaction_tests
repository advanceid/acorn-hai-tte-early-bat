library(interactionR)

#3GCRE
#==========================================================
# 1. Create binary variables
#==========================================================

analysis_3gcre <- analysis_3gcre %>%
  mutate(
    high_qsofa   = ifelse(severity_score >= 2, 1, 0),
    no_early_BAT = ifelse(A_day0 == 0, 1, 0)
  )

table(analysis_3gcre$high_qsofa, useNA = "ifany")

#==========================================================
# 2. Fit logistic interaction model
#==========================================================

fit_reri_qsofa <- glm(
  fourteen_day_death ~ high_qsofa * no_early_BAT,
  family = poisson(link = "log"),
  data = analysis_3gcre,
  weights = ipw
)

summary(fit_reri_qsofa)

#==========================================================
# 3. Calculate RERI using interactionR
#==========================================================

res_qsofa <- interactionR(
  model = fit_reri_qsofa,
  exposure_names = c(
    "high_qsofa",
    "no_early_BAT"
  ),
  ci.type = "mover",
  ci.level = 0.95,
  em = TRUE,
  recode = FALSE
)

interactionR_table(res_qsofa)

