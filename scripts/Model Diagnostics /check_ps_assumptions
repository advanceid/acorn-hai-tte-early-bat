#=========================================================
# Assess functional form of continuous covariates
#=========================================================

plot_functional_form <- function(data, variable, exposure = "A_day0") {
  
  ggplot(
    data,
    aes(
      x = .data[[variable]],
      y = .data[[exposure]]
    )
  ) +
    geom_point(
      alpha = 0.20,
      position = position_jitter(height = 0.05),
      colour = "grey50"
    ) +
    geom_smooth(
      method = "glm",
      method.args = list(family = "binomial"),
      se = FALSE,
      colour = "#D55E00",
      linewidth = 1
    ) +
    geom_smooth(
      method = "loess",
      se = FALSE,
      colour = "#0072B2",
      linewidth = 1
    ) +
    labs(
      title = paste("Functional form assessment:", variable),
      x = variable,
      y = "Probability of early appropriate therapy"
    ) +
    theme_bw()
  
}

