#---------------------------------------------------------
# Setup
#---------------------------------------------------------
source(here::here("scripts", "00_setup.R"))
#---------------------------------------------------------
# Load data
#---------------------------------------------------------
treatment <- readRDS(
  here("data", "raw", "anti_treat_index.RData")
)
baseline <- readRDS(
  here("data", "raw", "baseline_outcomes_index.RData")
)
day_by_day <- readRDS(
  here("data", "processed", "day_by_day.rds")
)

#---------------------------------------------------------
# Restrict to CAR phenotype
#---------------------------------------------------------

day_by_day_crab <- day_by_day %>%
  filter(resistance_class == "ACI-CARB")

#---------------------------------------------------------
# Collapse antibiotics to one row per patient-day
#---------------------------------------------------------
combo_by_day_crab <- day_by_day_crab %>%
  group_by(recordid, day_relative_to_onset) %>%
  summarise(
    ab_combo = paste(sort(unique(anti_names)), collapse = "+"),
    .groups = "drop"
  )
#---------------------------------------------------------
# Add patient-day metadata
#---------------------------------------------------------
meta_per_day <- day_by_day_crab %>%
  select(
    recordid,
    day_relative_to_onset,
    inf_onset,
    org_combined,
    bsi_source_clean,
    bsi_pri_sec_label
  ) %>%
  distinct()

combo_by_day_crab <- combo_by_day_crab %>%
  left_join(
    meta_per_day,
    by = c("recordid", "day_relative_to_onset")
  ) %>%
  mutate(
    ab_combo = na_if(ab_combo, "")
  )
#---------------------------------------------------------
# Create BSI source variable
#---------------------------------------------------------
combo_by_day_crab <- combo_by_day_crab %>%
  mutate(
    bsi_source = case_when(
      bsi_pri_sec_label == "Primary (unknown origin / central line)" ~
        "Primary (unknown origin / central line)",
      bsi_pri_sec_label == "Secondary (defined infection focus)" ~
        paste("Secondary -", bsi_source_clean),
      TRUE ~ NA_character_
    )
  ) %>%
  select(
    recordid,
    day_relative_to_onset,
    ab_combo,
    inf_onset,
    org_combined,
    bsi_source
  )
#---------------------------------------------------------
# Define BAT
#---------------------------------------------------------
check_appropriateness_crab_row <- function(row) {
  # parse ab_combo
  ab_list <- unlist(strsplit(row$ab_combo, "\\+"))
  ab_list <- trimws(ab_list)
  # helper AST
  check_ast <- function(drug) {
    if (!drug %in% names(row)) return(NA)
    v <- suppressWarnings(as.numeric(row[[drug]]))
    if (is.na(v)) return(NA)
    if (v == 1) return("R")
    if (v == 2) return("I")
    if (v == 3) return("S")
    if (v %in% c(4,5)) return("Missing")
    return(NA)
  }
  if (c("Colistin" %in% ab_list)) return("Appropriate")
  if (c("Ampicillin/sulbactam" %in% ab_list)) return("Appropriate")
  if (c("Cefoperazone/sulbactam" %in% ab_list)) return("Appropriate")
  if (c("Polymyxin B" %in% ab_list)) return("Appropriate")
  ## default
  return("Not appropriate")
}
# # apply function
combo_by_day_crab <- combo_by_day_crab %>%
  rowwise() %>%
  mutate(appropriateness = check_appropriateness_crab_row(pick(everything()))) %>%
  ungroup()

combo_by_day_crab <- combo_by_day_crab %>%
  select(recordid, ab_combo, appropriateness, everything())
#---------------------------------------------------------
# Define timing of first BAT
#---------------------------------------------------------
combo_by_day_crab <- combo_by_day_crab %>%
  group_by(recordid) %>%
  mutate(
    start_day = case_when(
      any(
        day_relative_to_onset %in% c(-1, 0, 1) &
          appropriateness == "Appropriate"
      ) ~ 0,
      any(
        day_relative_to_onset >= 2 &
          appropriateness == "Appropriate"
      ) ~ min(
        day_relative_to_onset[
          day_relative_to_onset >= 2 &
            appropriateness == "Appropriate"
        ],
        na.rm = TRUE
      ),
      TRUE ~ NA_real_
    )
  ) %>%
  ungroup()

#---------------------------------------------------------
# Define early appropriate therapy exposure
#---------------------------------------------------------

combo_by_day_crab <- combo_by_day_crab %>% 
  mutate(
    A_day0 = case_when(
      start_day == 0          ~ 1L,
      TRUE ~ 0L
    )
  )

#---------------------------------------------------------
# Define exposure regimen during the day-0 window
#---------------------------------------------------------

exposure_regimen <- combo_by_day_crab %>%
  group_by(recordid) %>%
  summarise(
    exposure_regimen = if (first(A_day0) == 1) {
      first(
        ab_combo[
          day_relative_to_onset %in% c(-1, 0, 1) &
            appropriateness == "Appropriate"
        ]
      )
    } else {
      paste(
        unique(
          na.omit(
            ab_combo[
              day_relative_to_onset %in% c(-1, 0, 1)
            ]
          )
        ),
        collapse = " | "
      )
      
    },
    
    .groups = "drop"
  )

combo_by_day_crab <- combo_by_day_crab %>%
  left_join(
    exposure_regimen,
    by = "recordid"
  )
